# Unity 核心忽略规则
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]nityGenerated/
[Pp]ackages/

# Unity 项目文件
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.pdb
*.opendb
*.VC.db

# 构建输出
*.apk
*.aab
*.ipa
*.unitypackage

# 保留必要的配置文件
!Packages/manifest.json
!Packages/NuGetPackages/NuGet.config
!Packages/NuGetPackages/package.json
!Packages/NuGetPackages/packages.config

# 系统文件
.DS_Store
Thumbs.db
Desktop.ini

# 编辑器缓存
.vs/
.vscode/
.idea/

# 用户特定文件
*.private
*.private.meta