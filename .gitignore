# Unity 核心忽略规则
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]nityGenerated/
[Ss]erverData/
[Mm]emoryCaptures/
HybridCLRData/
WGame_BurstDebugInformation_DoNotShip/
mono_crash.0.0.json
UserSettings/Layouts/default-2022.dwlt

# Unity 项目文件
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.pdb 
*.opendb
*.VC.db

# 构建输出
*.apk
*.aab
*.ipa
*.unitypackage

# 系统文件
.DS_Store
Thumbs.db
Desktop.ini

# 编辑器缓存
.vs/
.vscode/
.idea/

# 用户特定文件
*.private
*.private.meta

# Packages 文件夹：只忽略自动生成的内容，保留配置文件
Packages/nuget-packages/*
!Packages/nuget-packages/NuGet.config
!Packages/nuget-packages/package.json
!Packages/nuget-packages/packages.config